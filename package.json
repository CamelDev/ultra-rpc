{
  "name": "ultrarpc",
  "productName": "UltraRPC",
  "private": true,
  "version": "1.2.4",
  "description": "A lightweight API client for REST and gRPC — like Postman, but with native gRPC support, server reflection, and file-based collections.",
  "author": "UltraRPC",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "bunx rimraf dist dist-electron release",
    "build": "bun run clean && tsc -b && vite build",
    "package:win": "bun run build && electron-builder --win",
    "package:mac": "bun run build && electron-builder --mac",
    "package:linux": "bun run build && electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun run build && playwright test"
  },
  "build": {
    "appId": "com.ultrarpc.app",
    "productName": "UltraRPC",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-win.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonpath-plus": "^11.2.1",
    "prettier": "^3.9.10",
    "protobufjs": "^8.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@grpc/reflection": "^1.0.4",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cm6-graphql": "^0.2.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "framer-motion": "^14.6.0",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}